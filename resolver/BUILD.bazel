load("@rules_java//java:defs.bzl", "java_binary")
load("@rules_jvm_external//:defs.bzl", "artifact")
load("@rules_kotlin//kotlin:core.bzl", "kt_compiler_plugin")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library", "kt_jvm_test")

package(default_visibility = ["//visibility:public"])

RESOLVER_DEPS = [
    artifact("com.github.ajalt.clikt:clikt-jvm", "resolver_maven"),
    artifact("com.jetbrains.intellij.platform:jps-model", "resolver_maven"),
    artifact("io.ktor:ktor-client-cio-jvm", "resolver_maven"),
    artifact("io.ktor:ktor-client-core-jvm", "resolver_maven"),
    artifact("org.jetbrains.amper:dependency-resolution", "resolver_maven"),
    artifact("org.jetbrains.kotlinx:kotlinx-coroutines-core-jvm", "resolver_maven"),
    artifact("org.jetbrains.kotlinx:kotlinx-serialization-core-jvm", "resolver_maven"),
    artifact("org.jetbrains.kotlinx:kotlinx-serialization-json-jvm", "resolver_maven"),
    artifact("ch.qos.logback:logback-core", "resolver_maven"),
    artifact("org.slf4j:slf4j-api", "resolver_maven"),
]

RESOLVER_TEST_DEPS = RESOLVER_DEPS + [
    artifact("junit:junit", "resolver_maven"),
]

kt_compiler_plugin(
    name = "serialization_plugin",
    id = "org.jetbrains.kotlin.plugin.serialization",
    deps = ["@rules_kotlin//kotlin/compiler:kotlin-serialization-compiler-plugin"],
)

kt_jvm_library(
    name = "resolver_lib",
    srcs = [
        "src/org/jetbrains/kmp/resolver/ArtifactUrlResolver.kt",
        "src/org/jetbrains/kmp/resolver/AuthenticationHelpers.kt",
        "src/org/jetbrains/kmp/resolver/MultiplatformResolver.kt",
        "src/org/jetbrains/kmp/resolver/ResolveCommand.kt",
        "src/org/jetbrains/kmp/resolver/main.kt",
    ],
    plugins = [":serialization_plugin"],
    resource_strip_prefix = "resources",
    resources = glob(
        ["resources/**/*"],
    ),
    deps = RESOLVER_DEPS,
)

java_binary(
    name = "resolver",
    main_class = "org.jetbrains.kmp.resolver.MainKt",
    runtime_deps = [":resolver_lib"],
)

kt_jvm_test(
    name = "netrc_test",
    srcs = [
        "//resolver:test/org/jetbrains/kmp/resolver/RepositoryCredentialsTest.kt",
    ],
    associates = [":resolver_lib"],
    plugins = [":serialization_plugin"],
    resource_strip_prefix = "testResources",
    resources = glob(
        ["testResources/**/*"],
    ),
    test_class = "org.jetbrains.kmp.resolver.RepositoryCredentialsTest",
    deps = RESOLVER_TEST_DEPS,
)
